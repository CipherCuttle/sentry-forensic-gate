# Ink mainnet public RPC. Official primary as of 2026-09-13.
INK_RPC_URL=https://rpc-gel.inkonchain.com

# Canonical Sentry Launch Factory proxy on Ink.
SENTRY_LAUNCH_FACTORY=0xDc37e11B68052d1539fa23386eE58Ac444bf5BE1

# Required for the truth watcher: choose the first block you want indexed.
SENTRY_START_BLOCK=
SENTRY_CONFIRMATIONS=2
SENTRY_MAX_BATCH_BLOCKS=1000
SENTRY_REORG_LOOKBACK_BLOCKS=64
SENTRY_POLL_INTERVAL_MS=1500

# Executable baseline freezes quotes at launch block + this many blocks.
BASELINE_DECISION_DELAY_BLOCKS=2
BASELINE_CONFIRMATIONS=2
BASELINE_MAX_LAUNCHES_PER_SYNC=100
BASELINE_POLL_INTERVAL_MS=1500

# Forward outcome collection uses canonical launch-time horizons and waits this
# many additional blocks before persisting the horizon observation.
OUTCOME_CONFIRMATIONS=2
OUTCOME_MAX_PER_SYNC=100
OUTCOME_POLL_INTERVAL_MS=1500

# Serial runtime cycle interval when using pnpm start:runtime.
RUNTIME_POLL_INTERVAL_MS=5000

DB_PATH=./data/sentry-forensic-gate.sqlite
SHADOW_ONLY=true
