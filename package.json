{
  "name": "sentry-forensic-gate",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "selfcheck": "node scripts/selfcheck.mjs",
    "authoritycheck": "node scripts/sentry-authority-epoch-check.mjs && node scripts/sentry-ledger-epoch-check.mjs && node scripts/executable-infra-authority-check.mjs",
    "truthcheck": "node scripts/sentry-truth-check.mjs",
    "baselinecheck": "node scripts/executable-baseline-check.mjs && node scripts/executable-baseline-sqlite-check.mjs",
    "provenancecheck": "node scripts/provenance-facts-check.mjs",
    "creatoroutcomecheck": "node scripts/creator-outcome-check.mjs",
    "forwardoutcomecheck": "node scripts/forward-outcomes-check.mjs && node scripts/forward-outcome-final-authority-race-check.mjs",
    "creatorsignalcheck": "node scripts/creator-signal-eval-check.mjs && node scripts/creator-signal-missing-provenance-check.mjs",
    "historicalcompatibilitycheck": "node scripts/historical-compatibility-config-check.mjs",
    "historicalbaselinepolicycheck": "node scripts/historical-baseline-policy-config-check.mjs",
    "multichaincheck": "node scripts/multichain-m1-check.mjs",
    "ponsv2check": "node scripts/pons-v2-launch-adapter-check.mjs",
    "fastvetr1check": "node scripts/fast-vet-r1-capacity-gate-check.mjs",
    "test": "pnpm build && pnpm authoritycheck && pnpm selfcheck && pnpm truthcheck && pnpm baselinecheck && pnpm provenancecheck && pnpm creatoroutcomecheck && pnpm forwardoutcomecheck && pnpm creatorsignalcheck && pnpm historicalcompatibilitycheck && pnpm historicalbaselinepolicycheck && pnpm multichaincheck && pnpm ponsv2check && pnpm ponsv2marketcheck && pnpm ponsv2quotingcheck && pnpm ponsv2usdcheck && pnpm ponsv2baselinecheck && pnpm ponsv2creatorcheck && pnpm fastvetr1check && pnpm portableoutcomecheck",
    "start:truth": "node dist/cli.js",
    "start:baseline": "node dist/baselineCli.js",
    "start:creator-outcome": "node dist/creatorOutcomeCli.js",
    "start:outcomes": "node dist/forwardOutcomeCli.js",
    "start:creator-signal": "node dist/creatorSignalCli.js",
    "start:runtime": "node dist/researchRuntimeCli.js",
    "start:activation-receipt": "node dist/activationReceiptCli.js",
    "start:provider-capability": "node dist/providerCapabilityCli.js",
    "start:infra-discovery": "node dist/executableInfraDiscoveryCli.js",
    "start:historical-compatibility": "node dist/historicalCompatibilityCli.js",
    "start:historical-baseline-policy": "node dist/historicalBaselinePolicyCli.js",
    "ponsv2marketcheck": "node scripts/pons-v2-market-state-check.mjs",
    "ponsv2quotingcheck": "node scripts/pons-v2-curve-quote-check.mjs",
    "ponsv2usdcheck": "node scripts/pons-v2-usd-calibration-check.mjs",
    "ponsv2baselinecheck": "node scripts/pons-v2-portable-baseline-check.mjs",
    "ponsv2liveshadow": "node scripts/pons-v2-live-shadow-smoke.mjs",
    "ponsv2creatorcheck": "node scripts/pons-v2-creator-history-check.mjs",
    "ponsv2creatorindexed": "node scripts/pons-v2-creator-history-indexed-smoke.mjs",
    "portableoutcomecheck": "node scripts/portable-forward-outcomes-policy-receipts-check.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.10.1",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "typescript": "5.8.3",
    "@types/node": "20.19.43"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
